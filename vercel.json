{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/videos/(.*)",
      "dest": "/videos/$1"
    },
    {
      "src": "/funny_face.jpg",
      "dest": "/funny_face.jpg"
    },
    {
      "src": "/bot_avatar.jpg",
      "dest": "/bot_avatar.jpg"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
